# BOB.OS — Calculadora de Freelas
# Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas credenciais

# ─── Banco de Dados ────────────────────────────────────────────────────────────
# String de conexão PostgreSQL do Supabase (com pgbouncer ou direta)
# Nunca exponha esta variável com prefixo NEXT_PUBLIC_
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Auth (Better Auth) ───────────────────────────────────────────────────────
# Gere um segredo forte em linha de comando: openssl rand -base64 32
BETTER_AUTH_SECRET="substitua-por-um-segredo-forte-de-32-caracteres"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (opcional no MVP)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Chave pública (anon/publishable key) — seguro para uso no front-end com RLS ativo
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# ATENÇÃO: Nunca exponha chaves secretas (service_role ou DATABASE_URL) no front-end
