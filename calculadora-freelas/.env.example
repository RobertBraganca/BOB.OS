# BOB.OS — Calculadora de Freelas
# Template de variáveis de ambiente
# Copie este arquivo para .env.local e preencha com suas credenciais

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Chave pública (anon/publishable key) — seguro para uso no front-end com RLS ativo
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# ATENÇÃO: Nunca exponha chaves secretas (service_role ou DATABASE_URL) no front-end
